{
  "name": "separation-table",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "bin": { "sep": "./src/cli/sep.mjs" },
  "description": "Screen-print colour separations on the command line and over MCP: films, a Photoshop file, separation.json, a mix sheet and a job sheet.",
  "engines": { "node": ">=22" },
  "files": ["src/cli/", "src/engine.js", "src/pipeline.js", "src/plan.js", "src/checks.js", "src/inks.js", "src/sizes.js", "src/output.js", "src/cvtools.js", "src/vector.js", "src/job.js", "src/filmimport.js", "src/version.js", "README.md", "NOTICE",
    "src/vendor/quickhull.js", "src/vendor/color-fn.js", "src/vendor/jszip.min.js", "src/vendor/pdf-lib.min.js", "src/vendor/vtracer.js", "src/vendor/vtracer.wasm"],
  "scripts": {
    "setup": "node scripts/fetch-vendor.mjs",
    "start": "node scripts/server.cjs",
    "check": "node tests/check.mjs",
    "test": "node tests/check.mjs && node tests/fuzz.mjs 40 369 && node tests/cli.mjs",
    "gate": "python3 scripts/prep-images.py && node tests/bench-test.mjs --gate tests/baseline.json",
    "gate:update": "python3 scripts/prep-images.py && node tests/bench-test.mjs --gate tests/baseline.json --update",
    "benchmark": "node benchmark/run.mjs",
    "setup:e2e": "npm install --no-save --no-package-lock --silent --prefix .cache/pw playwright@1.49.1 && npx --prefix .cache/pw playwright install chromium",
    "e2e": "NODE_PATH=.cache/pw/node_modules node tests/e2e.cjs",
    "shots": "node scripts/shots.cjs",
    "typecheck": "npm install --no-save --no-package-lock --silent --prefix .cache/ts typescript@5.6.3 && .cache/ts/node_modules/.bin/tsc -p tsconfig.json",
    "fuzz": "node tests/fuzz.mjs 60 369",
    "mutate": "node tests/mutate.mjs",
    "stress": "node tests/phone-stress.cjs",
    "pack:check": "node tests/package.mjs",
    "status": "node scripts/status.mjs",
    "release:check": "node scripts/release.mjs check",
    "release:draft": "node scripts/release.mjs draft",
    "notices": "node scripts/notices.mjs",
    "icons": "node scripts/render-icons.mjs",
    "icons:check": "node scripts/render-icons.mjs --check"
  },
  "license": "MIT"
}
